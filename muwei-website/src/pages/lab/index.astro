---
// 木尉實驗室 hub. Add a tool = add one entry to src/data/lab-tools.json and put its files in /lab/<slug>/.
import tools from '../../data/lab-tools.json';
const groups = [
  { key: 'tool', label: 'TOOLS — 工具', items: tools.filter((t) => t.category === 'tool') },
  { key: 'creative', label: 'WORKS — 創作', items: tools.filter((t) => t.category === 'creative') },
].filter((g) => g.items.length);
---
<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="木尉實驗室：楊文翔自己在用的小工具與創作計畫，歡迎一起用。"><title>木尉實驗室｜Muwei Film 木尉影像</title><link rel="canonical" href="https://www.muweifilm.com/lab/"><meta property="og:title" content="木尉實驗室｜Muwei Film 木尉影像"><meta property="og:description" content="這些是我自己在用的工具，歡迎一起用。"><meta property="og:image" content="https://www.muweifilm.com/images/og.jpg"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500&family=Noto+Serif+TC:wght@500;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="/site.css"></head><body>
<a class="skip" href="#main">跳到主要內容</a><header class="bar"><a class="bar__mark" href="/index.html">MUWEI FILM<span>木尉影像</span></a><nav class="bar__nav" aria-label="主選單"><a href="/works.html">作品</a><a href="/services.html">服務</a><a href="/about.html">關於</a><a href="/lab/" aria-current="page">實驗室</a><a class="cta" href="/contact.html">談合作</a></nav></header>
<main id="main" class="wrap"><section><p class="eyebrow">05 — MUWEI LAB</p><h1 class="page-title">木尉實驗室</h1><p class="intro">這些是我自己在用的工具，歡迎一起用。</p></section>
{groups.map((g) => (
<section class="section rule"><p class="eyebrow">{g.label}</p><div class="lab-grid">{g.items.map((t) => (
<a class="lab-card" href={t.href} data-slug={t.slug}><h2>{t.name}</h2><p>{t.summary}</p><dl><div><dt>狀態</dt><dd>{t.status}</dd></div><div><dt>使用</dt><dd>{t.access}</dd></div></dl><span class="lab-card__go" aria-hidden="true">打開 →</span></a>
))}</div></section>
))}
<section class="section rule"><p class="section-note">做這些工具的人，平常在做影像。<a class="inline-link" href="/index.html">看看木尉影像 →</a></p></section></main><footer class="foot"><p class="foot__mark">MUWEI FILM 木尉影像</p><p>© 2026 楊文翔 Jeffrey Yang</p></footer></body></html>
